  "narrative": {
    "northStar": "The Connected Route",
    "overview": "A calm, direct system built around the connection between OZON and DPD. Clear typography and spacious surfaces give technical information a simple, approachable presence. The supplied identity assets and the two brands' colors anchor the system.\n\nFlat surfaces and restrained geometry support a confident, uncluttered interface. Lines represent connections or ordered steps; the interactive shipment example turns the integration into a visible sequence. The language here records the implemented direction; it is not a separate brand approval.",
    "keyCharacteristics": [
      "Spacious, flat surfaces with cool tonal separation.",
      "Dense Manrope headings and readable Russian body copy.",
      "Blue actions, red brand accents, and explicit connection geometry.",
      "Small, purposeful movement with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Connection Rule",
        "body": "Use lines to explain a route, relationship, or sequence rather than as repeated decorative separators.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use the supplied identity assets and established blue/red roles.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do preserve word spacing when removing responsive line breaks.",
      "Do use real service imagery and label illustrative shipment states."
    ],
    "donts": [
      "Don't introduce shadows into the established flat surface system without a deliberate design change.",
      "Don't replace the real login preview with a fabricated authenticated dashboard.",
      "Don't present reference-site prices or test conditions as confirmed DPD terms."
    ]
  }
